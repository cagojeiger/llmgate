# Build context shrinks: skip everything that isn't required to compile
# the gateway. .env stays out of the image so secrets never bake in.
.git
.gitignore
.dockerignore
.env
.env.example
.omc/
.repos/
.tmp/
.venv/
.pytest_cache/
__pycache__/
bin/
docs/
tests/
scripts/
README.md
*.md

# Native Mac worker source, private test fixtures and model/build caches are not server image input.
cli/

caller/
